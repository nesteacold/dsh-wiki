{
  "name": "@dsh-ext/dsh-wiki",
  "version": "0.3.3",
  "description": "Local Repo Wiki (DeepWiki-style): the agent reads a repository locally and writes a paged, evidence-cited wiki (page tree + diagrams + knowledge cards), built into a single self-contained site and browsable natively in DSH. Nothing uploaded, zero network.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "mcp",
    "skills",
    "assets",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "keywords": [
    "dsh-plugin",
    "wiki",
    "deepwiki",
    "documentation",
    "offline",
    "local-first",
    "privacy"
  ],
  "private": true,
  "license": "MIT",
  "author": {
    "name": "neste"
  },
  "contributors": [
    {
      "name": "acfufu",
      "url": "https://github.com/Acfufu/dsh-wiki"
    }
  ]
}
