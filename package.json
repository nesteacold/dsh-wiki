{
  "name": "@dsh-ext/dsh-wiki",
  "version": "0.1.2",
  "description": "纯本地 Repo Wiki（DeepWiki 式）：agent 本地读懂仓库，生成带证据引用的分页 wiki（目录树+图表），构建单文件自包含站点，零上传零网络。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "assets",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.1 || ^0.2.0-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "wiki",
    "deepwiki",
    "documentation",
    "offline",
    "local-first",
    "privacy"
  ],
  "license": "MIT",
  "author": {
    "name": "acfufu"
  }
}
